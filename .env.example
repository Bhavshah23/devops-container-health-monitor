# Copy this file to .env and paste a Discord channel webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
WEBHOOK_SECRET=change-this-lab-secret
POLL_INTERVAL_SECONDS=10
ALERT_COOLDOWN_SECONDS=60
MONITOR_LABEL=health-monitor.enabled
START_MONITOR=true
HOST_PORT=5001
